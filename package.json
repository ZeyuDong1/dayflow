{
  "name": "dayflow-win",
  "productName": "Dayflow",
  "version": "1.0.0",
  "description": "The automatic work journal for Windows. Privately turns your screen into a timeline of what you actually accomplished. Windows port of JerryZLiu/Dayflow.",
  "main": "./out/main/index.js",
  "author": "Dayflow Win contributors",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64",
    "fetch-ai-memory": "node tools/fetch-ai-memory.mjs"
  },
  "dependencies": {
    "active-win": "^9.0.0",
    "koffi": "^3.3.3",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "koffi@3.3.3": true,
    "electron@45.0.0": true
  }
}
